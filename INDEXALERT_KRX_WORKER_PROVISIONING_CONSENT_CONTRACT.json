{
  "schema_version": "1",
  "contract_id": "INDEXALERT-KRX-WORKER-PROVISIONING-v1",
  "created_date": "2026-10-02",
  "purpose": "Authorize only dedicated Railway worker infrastructure provisioning and preflight-only deployment, never KRX historical or expected-scope network execution.",
  "exact_user_approval_phrase": "I_AUTHORIZE_INDEXALERT_KRX_WORKER_PROVISIONING_v1",
  "cost_notice": "Creating a Railway service and persistent volume may incur Railway usage/storage charges.",
  "allowed_mutations_after_explicit_approval": [
    "create Railway service indexalert-krx-historical-worker from kims34/openpilot-opkr branch index-alert-research-v1",
    "set Dockerfile to Dockerfile.krx-historical-worker",
    "set default start command to python research_v1_krx_historical_worker_entrypoint.py",
    "set restart policy NEVER",
    "ensure no public domain",
    "ensure no cron",
    "create and attach a dedicated persistent volume at /data",
    "set non-secret KRX_PRIVATE_RAW_DIR=/data/indexalert/krx-historical-v3",
    "set non-secret INDEXALERT_KRX_HIST_WORKER_ROLE=DEDICATED_ONE_SHOT",
    "perform preflight-only deployment with no KRX acquisition consent variables present"
  ],
  "explicitly_not_authorized": [
    "set KRX_HISTORICAL_ACQUISITION_CONSENT",
    "set KRX_EXPECTED_SCOPE_ATTESTATION_CONSENT",
    "run --execute-identity-seed",
    "run --execute-identity-standard-code-binding",
    "run --execute-per-security-history",
    "run --execute-status-economics",
    "execute expected-scope network sweep",
    "reuse indexalert-runtime /data volume",
    "create public domain",
    "enable cron",
    "feature-performance testing",
    "sealed holdout",
    "live trading"
  ],
  "secret_boundary": {
    "required_worker_secret_names": [
      "KRX_ID",
      "KRX_PW",
      "KRX_AUTH_KEY"
    ],
    "secret_values_must_not_be_committed_to_git": true,
    "secret_values_must_not_be_sent_in_chat": true,
    "assistant_currently_cannot_read_github_secret_values": true,
    "user_must_enter_worker_secret_values_in_railway_secret_ui_if_cross_service_copy_is_unavailable": true
  },
  "authority": {
    "provisioning_authorized_by_user": false,
    "worker_service_creation_authorized": false,
    "dedicated_volume_creation_authorized": false,
    "worker_secret_configuration_authorized": false,
    "bulk_network_execution_authorized_by_user": false,
    "expected_scope_network_execution_authorized_by_user": false,
    "sealed_holdout_authorized": false,
    "live_trading_authorized": false
  }
}
