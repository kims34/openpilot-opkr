        }
      },
      "dynamic_standard_code_snapshots": {
        "route": "KRX_OPENAPI_STK_ISU_BASE_INFO",
        "method": "GET",
        "rule": "After new-listing history is acquired, request one basic-info snapshot per unique listing date inside the research period.",
        "request_count_formula": "U_new_listing_dates",
        "mapping_rule": "For a newly listed episode, ISU_CD and ISU_SRT_CD must come from the basic-info snapshot whose basDd equals that episode's listing date.",
        "no_fallback_from_later_snapshot": true
      },
      "identity_rules": {
        "market_filter": "KOSPI only",
        "common_stock_filter": "SECUGRP_NM=주권 and KIND_STKCERT_TP_NM=보통주",
        "never_join_by_name_only": true,
        "episode_key": "market|short_code|listing_date",
        "standard_code_required_for_every_episode": true,
        "standard_code_source_for_preexisting_episode": "research_start_security_master",
        "standard_code_source_for_new_episode": "listing-date security-master snapshot",
        "end_snapshot_is_reconciliation_only": true,
        "overlapping_same_short_code_episodes_fail_closed": true,
        "missing_listing_date_fail_closed": true,
        "unresolved_standard_code_fail_closed": true,
        "inconsistent_standard_code_across_snapshots_fail_closed": true,
        "per_security_isuCd": "standard_code",
        "trading_halt_isuCd2": "short_code"
