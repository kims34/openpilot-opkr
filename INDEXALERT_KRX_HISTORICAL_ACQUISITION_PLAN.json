          "method": "GET",
          "basDd": "20150615",
          "request_count": 1,
          "purpose": "Capture standard-code/short-code/listing-date mapping for securities already active at research start."
        },
        {
          "name": "research_end_security_master",
          "route": "KRX_OPENAPI_STK_ISU_BASE_INFO",
          "endpoint": "https://data-dbg.krx.co.kr/svc/apis/sto/stk_isu_base_info",
          "method": "GET",
          "basDd": "20261001",
          "request_count": 1,
          "purpose": "End-date reconciliation only; must not invent missing historical episodes."
